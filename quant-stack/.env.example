# quant-stack — non-sensitive runtime config.
# Secrets (Schwab OAuth tokens) live in the OS keychain, NEVER here.
# Run `python -m config.secrets --set-schwab-token` to seed.

# ── Runtime mode ──────────────────────────────────────────────────────
# dev    - all writes scoped to data/dev/, no Schwab calls
# paper  - real market data, simulated fills, no live orders
# live   - live orders ONLY with --i-mean-it boot flag (Phase 7+)
APP_ENV=dev

# Which Schwab API surface to point at: production | sandbox
SCHWAB_ENV=sandbox

# Hard safety. Set to false only when ready for Phase 7 live trading.
PAPER_TRADING=true

# ── Paths ─────────────────────────────────────────────────────────────
DATA_DIR=data
AUDIT_DIR=audit
LOG_DIR=logs
MEMORY_DIR=memory

# ── Schwab client tuning ──────────────────────────────────────────────
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_REQUEST_TIMEOUT_S=10.0
SCHWAB_RATE_LIMIT_RPS=2.0

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON_TO_FILE=true
