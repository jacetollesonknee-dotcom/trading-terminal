{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-stack.local/schemas/strategies.schema.json",
  "title": "Strategies (named, parameterized, naked-only)",
  "description": "Every active strategy lives here. `structure` is locked to the naked-only allowlist until Phase 8 opens it via a separate ADR. The order generator and the MCP propose_trade tool both validate against this list.",
  "type": "array",
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "thesis", "underlyings", "structure", "entry", "exit", "position_sizing"],
    "properties": {
      "name": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,63}$",
        "description": "Stable identifier. Used in episodic logs and signal attribution."
      },
      "thesis": {
        "type": "string",
        "minLength": 30,
        "description": "Why this works and why it hasn't been arbed away. Per §4 of the brief."
      },
      "underlyings": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9.\\-]{0,11}$"}
      },
      "structure": {
        "type": "string",
        "enum": ["long_call", "long_put", "cash_secured_put", "covered_call"],
        "description": "Naked-only v1. Schema-level enforcement of Principle #7."
      },
      "entry": {"type": "object"},
      "exit": {"type": "object"},
      "position_sizing": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "max_buying_power_pct": {"type": "number", "minimum": 0, "maximum": 100},
          "max_vega_usd_per_volpt": {"type": "number", "minimum": 0},
          "max_delta_usd": {"type": "number"},
          "csp_collateral_aware": {"type": "boolean"},
          "kelly_fraction": {"type": "number", "minimum": 0, "maximum": 0.25,
            "description": "Capped at 25% of full Kelly per §5."}
        }
      },
      "regime_filter": {
        "type": "array",
        "items": {"type": "string", "enum": ["low_vol", "high_vol"]},
        "description": "If present, signal only fires when HMM state ∈ this list."
      },
      "tier_eligibility": {
        "type": "array",
        "items": {"type": "string", "enum": ["tier_1_core", "tier_2_tactical", "tier_3_speculation"]},
        "description": "If present, underlyings must be in one of these watchlist tiers."
      },
      "phase_status": {
        "type": "string",
        "enum": ["research", "backtest_passed", "paper", "live_small", "live", "paused", "retired"],
        "default": "research"
      },
      "paper_start_date": {"type": "string", "format": "date"},
      "live_start_date": {"type": "string", "format": "date"}
    }
  }
}
