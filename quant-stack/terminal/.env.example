# ── Schwab / ThinkorSwim ──────────────────────────────────────────────
# Get these from developer.schwab.com → Your App
SCHWAB_API_KEY=pending
SCHWAB_SECRET=pending
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# Path where OAuth token gets saved after first login
TOKEN_PATH=schwab_token.json

# ── Anthropic (Claude Opus 4.7) ───────────────────────────────────────
# Get from console.anthropic.com.  The terminal uses claude-opus-4-7
# with extended thinking + prompt caching by default.
ANTHROPIC_API_KEY=your-key-here

# ── Data Settings ─────────────────────────────────────────────────────
# Set to "false" to use demo/simulated prices.
USE_LIVE_DATA=true

# ── Engine ingestion (ADR-004) ────────────────────────────────────────
# Run the engine's real-time ingestion scheduler in-process and stream
# its events to the browser (Live Ingestion card + /api/engine/status).
# Set to "false" to run the terminal on its own data_feeds only.
ENGINE_SCHEDULER=true
# Which engine store env the terminal reads/writes (dev | paper | live).
APP_ENV=dev

# ── Trading Mode ──────────────────────────────────────────────────────
# Set to "false" only when wiring up live trading via Schwab.
PAPER_TRADING=true

# ── Paper Portfolio ───────────────────────────────────────────────────
# Starting cash for the paper account.  All P&L is measured against this.
INITIAL_CASH=30000

# Where portfolio + watchlist + alerts get persisted between runs.
STATE_PATH=trader_state.json

# Port the Flask app listens on.
PORT=5000
